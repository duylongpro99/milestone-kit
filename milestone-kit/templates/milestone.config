# scripts/milestone/config — project settings for scripts/milestone/* (sourced by lib.sh).
# Written by the bootstrap; not overwritten by scripts/bootstrap/install.
MS_PANE_PREFIX={{PANE_PREFIX}}
MS_COMPONENT_ROOTS="{{COMPONENT_ROOTS}}"
MS_WHOLE_DIRS="{{WHOLE_DIRS}}"
MS_CONTRACT_GLOBS="{{CONTRACT_GLOBS}}"
MS_DEFAULT_BASE={{BASE_BRANCH}}
# first word of an ## Exit checks command that exit-check may run (ERE)
MS_CHECK_ALLOW='{{CHECK_ALLOW}}'
# CLI the worker sessions run: claude | codex (hooks file, session skill, skill links follow it)
MS_AGENT=claude
