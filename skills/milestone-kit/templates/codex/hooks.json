{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/hooks/guard-superpowers-paths.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/hooks/guard-scope.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/hooks/guard-superpowers-paths.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/hooks/guard-scope.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/hooks/require-handoff.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
